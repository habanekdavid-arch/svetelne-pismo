# ─────────────────────────────────────────────────────────────────────────────
# rozsvieťTO — environment
#
# Copy to .env.local for development. In production these live in the Vercel
# project settings. Nothing here is a real value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Sessions ─────────────────────────────────────────────────────────────────
# Any long random string; changing one signs everybody out of that side.
USER_SESSION_SECRET="…"
ADMIN_SESSION_SECRET="…"
# Comma-separated e-mails allowed into /admin.
ADMIN_EMAILS="ty@example.sk"

# ── The site's own address ───────────────────────────────────────────────────
# Where Stripe sends the customer back to. Without it, Vercel's own host is
# used — right for previews, but set it in production.
NEXT_PUBLIC_SITE_URL="https://rozsvietto.sk"

# ── Stripe ───────────────────────────────────────────────────────────────────
# Leave empty and the shop still works: the order is recorded and payment is
# arranged by e-mail. Fill them in and checkout redirects to Stripe.
#
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_… while testing).
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint you create at
# https://dashboard.stripe.com/webhooks pointing at
#   https://<your-domain>/api/stripe/webhook
# subscribed to: checkout.session.completed,
#                checkout.session.async_payment_succeeded,
#                checkout.session.async_payment_failed,
#                checkout.session.expired,
#                charge.refunded
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""

# ── Packeta (Zásielkovňa) ────────────────────────────────────────────────────
# Widget API key — 16 characters, from https://client.packeta.com. This one is
# public by design: it goes to the browser to open the pick-up point map.
NEXT_PUBLIC_PACKETA_API_KEY=""
# API password — 32 characters, from the same place. SECRET: it creates
# packets. Leave empty and packets are created by hand from the admin.
PACKETA_API_PASSWORD=""
# Sender label as set up at https://client.packeta.com/senders/.
PACKETA_SENDER_LABEL="rozsvietTO"
# Carrier id for courier-to-address delivery. Account- and country-specific —
# take it from Packeta's carrier export. Without it only pick-up points are
# offered for Packeta.
PACKETA_HOME_CARRIER_ID=""

# ── Delivery prices and limits (optional) ────────────────────────────────────
# Gross € shown to the customer. Defaults: 4.90 / 6.90.
NEXT_PUBLIC_DELIVERY_PRICE_PICKUP=""
NEXT_PUBLIC_DELIVERY_PRICE_HOME=""
# What Packeta will carry. Beyond these the sign is only offered for collection
# in person or freight arranged by hand. Check them against your Packeta
# contract — the defaults are deliberately conservative (10 kg / 70 cm for a
# pick-up point, 30 kg / 120 cm for a courier).
NEXT_PUBLIC_PACKETA_PICKUP_MAX_KG=""
NEXT_PUBLIC_PACKETA_PICKUP_MAX_CM=""
NEXT_PUBLIC_PACKETA_HOME_MAX_KG=""
NEXT_PUBLIC_PACKETA_HOME_MAX_CM=""
