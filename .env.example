# ─────────────────────────────────────────────────────────────────────────────
# rozsvieťTO — environment
#
# Copy to .env.local for development. In production these live in the Vercel
# project settings (Settings → Environment Variables). Nothing here is a real
# value. What each one switches on, and where to get it:
# docs/API-KLUCE-TODO.md. The admin (/admin → "Stav integrácií") shows which
# are set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) — already set on Vercel ─────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Sessions — already set on Vercel ─────────────────────────────────────────
# Any long random string; changing one signs everybody out of that side.
# USER_SESSION_SECRET also signs password-reset links.
USER_SESSION_SECRET="…"
ADMIN_SESSION_SECRET="…"
# Comma-separated e-mails allowed into /admin.
ADMIN_EMAILS="ty@example.sk"

# ── The site's own address ───────────────────────────────────────────────────
# Used in e-mails and as Stripe's return address. Without it, Vercel's own
# host is used — right for previews, but set it in production.
NEXT_PUBLIC_SITE_URL="https://rozsvietto.sk"

# ── Stripe — card payment ────────────────────────────────────────────────────
# Leave empty and the cart simply does not offer card payment.
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_… while testing,
# sk_live_… in production).
STRIPE_SECRET_KEY=""
# Signing secret (whsec_…) of the webhook endpoint created at
# https://dashboard.stripe.com/webhooks pointing at
#   https://<your-domain>/api/stripe/webhook
# subscribed to: checkout.session.completed,
#                checkout.session.async_payment_succeeded,
#                checkout.session.async_payment_failed,
#                checkout.session.expired,
#                charge.refunded
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""

# ── Bank transfer ────────────────────────────────────────────────────────────
# Leave BANK_IBAN empty and the cart does not offer a transfer. With it, the
# order page (and the e-mail) show IBAN, variable symbol and amount; the admin
# confirms the payment with "Platba prijatá".
BANK_IBAN=""
BANK_ACCOUNT_HOLDER="rozsvietTO"
BANK_BIC=""

# ── Packeta (Zásielkovňa) ────────────────────────────────────────────────────
# Widget API key — from https://client.packeta.com (Nastavenia klienta). Public
# by design: it opens the pick-up point map in the browser. Without it the cart
# offers only the courier.
NEXT_PUBLIC_PACKETA_API_KEY=""
# API password — same page. SECRET: it creates packets. Without it packets are
# entered by hand in Packeta's client portal.
PACKETA_API_PASSWORD=""
# Sender label as set up at https://client.packeta.com/senders/.
PACKETA_SENDER_LABEL="rozsvietTO"
# Carrier id for courier-to-address delivery (account- and country-specific,
# from Packeta's carrier list). Without it courier parcels are booked by hand.
PACKETA_HOME_CARRIER_ID=""

# ── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Order confirmations, quotes, payment and parcel notices, contact form and
# password reset. Any SMTP mailbox works (Microsoft 365: smtp.office365.com,
# Google Workspace: smtp.gmail.com with an app password, Websupport:
# smtp.m1.websupport.sk …). Leave empty and nothing is e-mailed.
SMTP_HOST=""
SMTP_PORT="587"
# "true" for port 465 (implicit TLS); 587 uses STARTTLS.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
# Sender shown to customers.
EMAIL_FROM="rozsvieťTO <info@rozsvietto.sk>"
# The shop's own inbox — new orders, quote requests, contact messages.
SHOP_EMAIL="info@rozsvietto.sk"

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Tag Manager container id (GTM-XXXXXXX). Loaded only after the visitor
# accepts analytics cookies.
NEXT_PUBLIC_GTM_ID=""

# ── Delivery prices and limits (optional) ────────────────────────────────────
# Gross € shown to the customer. Defaults: 4.92 (Packeta) / 6.15 (courier) —
# the same as vytlacto3d.
NEXT_PUBLIC_DELIVERY_PRICE_PICKUP=""
NEXT_PUBLIC_DELIVERY_PRICE_HOME=""
# What a parcel may weigh / measure. Beyond these the sign goes by freight
# arranged by hand. Defaults: 10 kg / 70 cm pick-up point, 30 kg / 120 cm
# courier — check them against your Packeta contract.
NEXT_PUBLIC_PACKETA_PICKUP_MAX_KG=""
NEXT_PUBLIC_PACKETA_PICKUP_MAX_CM=""
NEXT_PUBLIC_PACKETA_HOME_MAX_KG=""
NEXT_PUBLIC_PACKETA_HOME_MAX_CM=""
