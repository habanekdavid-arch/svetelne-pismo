# ─────────────────────────────────────────────────────────────────────────────
# rozsvieťTO — environment
#
# Copy to .env.local for development. In production these live in the Vercel
# project settings (Settings → Environment Variables). Nothing here is a real
# value. What each one switches on, and where to get it:
# docs/API-KLUCE-TODO.md. The admin (/admin → "Stav integrácií") shows which
# are set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) — already set on Vercel ─────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Sessions — already set on Vercel ─────────────────────────────────────────
# Any long random string; changing one signs everybody out of that side.
# USER_SESSION_SECRET also signs password-reset links.
USER_SESSION_SECRET="…"
ADMIN_SESSION_SECRET="…"
# Comma-separated e-mails allowed into /admin.
ADMIN_EMAILS="ty@example.sk"

# ── The site's own address ───────────────────────────────────────────────────
# Used in e-mails and as Stripe's return address. Without it, Vercel's own
# host is used — right for previews, but set it in production.
NEXT_PUBLIC_SITE_URL="https://rozsvietto.sk"

# ── Stripe — card payment ────────────────────────────────────────────────────
# Leave empty and the cart simply does not offer card payment.
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_… while testing,
# sk_live_… in production).
STRIPE_SECRET_KEY=""
# Signing secret (whsec_…) of the webhook endpoint created at
# https://dashboard.stripe.com/webhooks pointing at
#   https://<your-domain>/api/stripe/webhook
# subscribed to: checkout.session.completed,
#                checkout.session.async_payment_succeeded,
#                checkout.session.async_payment_failed,
#                checkout.session.expired,
#                charge.refunded
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""

# ── Bank transfer ────────────────────────────────────────────────────────────
# On by default: the same account vytlacto3d uses (4from media, s.r.o.,
# Tatra banka, SK35 1100 0000 0029 4526 7328 — lib/bank.ts). Set these only
# to send transfers somewhere else.
BANK_IBAN=""
BANK_ACCOUNT_HOLDER=""
BANK_BIC=""

# ── E-mail — the same mailbox and settings as vytlacto3d ─────────────────────
# Same variable names as the vytlacto3d project on Vercel: copy the values
# across. Order confirmations, quotes, payment notices, contact form and
# password reset. Only the password is required; without it nothing is
# e-mailed. Defaults (as vytlacto3d): mailbox info@4frommedia.sk on
# smtp.office365.com:587, sent from "rozsvieťTO <info@4frommedia.sk>",
# orders to info@4frommedia.sk.
SMTP_PASSWORD=""
SMTP_USER=""
SMTP_HOST=""
SMTP_PORT=""
# "true" for port 465 (implicit TLS); 587 uses STARTTLS.
SMTP_SECURE=""
# Sender; leave empty for "rozsvieťTO <info@4frommedia.sk>". (vytlacto3d's own
# EMAIL_FROM carries its name — do not copy that one.)
EMAIL_FROM=""
# The shop's inbox for new orders, quote requests and contact messages.
ADMIN_ORDER_EMAIL=""
# Where customers' replies go (defaults to ADMIN_ORDER_EMAIL).
EMAIL_REPLY_TO=""
# Backup: Gmail with an app password, used when the primary server fails.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Tag Manager container id (GTM-XXXXXXX). Loaded only after the visitor
# accepts analytics cookies.
NEXT_PUBLIC_GTM_ID=""

# ── Delivery prices and limits (optional) ────────────────────────────────────
# Gross € shown to the customer for DPD. Default: 6.15 (5 € + 23 % DPH).
# Collecting in person — Prievidza or Bratislava — is always free.
NEXT_PUBLIC_DELIVERY_PRICE_DPD=""
# What a DPD parcel may weigh / measure. Beyond these the sign goes by freight
# arranged by hand. Defaults: 31.5 kg / 175 cm (DPD Classic).
NEXT_PUBLIC_DPD_MAX_KG=""
NEXT_PUBLIC_DPD_MAX_CM=""
