// Prisma is used only for the admin login (AdminUser) — a deliberate,
// separate auth system from Clerk (which stays for customer accounts). See
// lib/admin-auth.ts. Orders keep using lib/db.ts / lib/orders.ts (raw SQL
// via @neondatabase/serverless) — both point at the same Neon DATABASE_URL,
// Postgres doesn't care which client wrote which table.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 no longer accepts it
// here) and the runtime PrismaClient uses a Neon driver adapter (lib/prisma.ts)
// instead — both read the same DATABASE_URL.
datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}
